# Copia este archivo a .env (o exporta las variables) y pon tu clave de DeepSeek.
DEEPSEEK_API_KEY=sk-...

# Opcionales (tienen valores por defecto):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash   # o deepseek-v4-pro

# Si no hay clave en el entorno ni en .env/.env.local, se busca como último
# recurso en el .env.local del proyecto EdifcIA (~/Proyectos/EdifcIA por
# defecto). Solo hace falta si lo moviste de lugar:
# EDIFICIA_DIR=/ruta/a/EdifcIA
